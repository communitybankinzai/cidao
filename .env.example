# 管理通知先メールアドレス（運営が指定）
ADMIN_NOTIFY_EMAIL=
# Anthropic 管理用キー（既存の費用警告。Anthropic Console）
ANTHROPIC_ADMIN_KEY=
# Anthropic API キー（Anthropic Console。サーバー専用）
ANTHROPIC_API_KEY=
# メタバース設定の管理パスワード（運営が設定）
CBI_ADMIN_PASSWORD=
# 費用警告の通知先（運営が指定）
COST_ALERT_TO=
# Anthropic 残高警告の閾値 USD（運営が指定）
CREDIT_ALERT_THRESHOLD_USD=
# 残高基準の日時 ISO 8601（運営が確認）
CREDIT_BASELINE_AT=
# 基準日時の Anthropic 残高 USD（運営が確認）
CREDIT_BASELINE_USD=
# Cron API の認証シークレット（ホスティング環境と共有）
CRON_SECRET=
# PostgreSQL 接続文字列（Supabase Connect。適用先を必ず確認）
DATABASE_URL=
# 災害画像登録 API の共有シークレット（運営が設定）
DISASTER_SHOT_SECRET=
# Facebook ページアクセストークン（Meta 開発者設定）
FACEBOOK_PAGE_ACCESS_TOKEN=
# Facebook ページ ID（Meta ページ設定）
FACEBOOK_PAGE_ID=
# GAS メール取得用パスワード（既存 GAS 管理者）
GAS_MAIL_PASSWORD=
# GAS メール取得 Web アプリ URL（既存 GAS 管理者）
GAS_MAIL_WEBAPP_URL=
# 既存 Google Cloud プロジェクト ID（GCP Console）
GCP_PROJECT_ID=
# GCP サービスアカウント鍵 JSON（GCP Console。サーバー専用）
GCP_SA_KEY=
# 既存 GitHub Actions dispatch 先 owner/repo（運営が指定）
GITHUB_DISPATCH_REPO=
# GitHub Actions dispatch 用トークン（GitHub）
GITHUB_DISPATCH_TOKEN=
# 更新履歴の GitHub 読み取りトークン（GitHub）
GITHUB_TOKEN=
# イベント取り込み Bot の members.id（運営が確認）
INGEST_BOT_MEMBER_ID=
# イベント取り込み API の共有シークレット（運営が設定）
INGEST_SHARED_SECRET=
# キー期限警告の予告日数（運営が指定）
KEY_EXPIRY_ALERT_DAYS=
# LINE Messaging API トークン（LINE Developers。Login 用とは別）
LINE_CHANNEL_ACCESS_TOKEN=
# メール送信元（Resend で検証済みのアドレス）
MAIL_FROM=
# メタバース入場トークン署名用シークレット（運営が設定）
METAVERSE_TOKEN_SECRET=
# ニュース OG 画像 API の共有シークレット（運営が設定）
NEWS_OG_SECRET=
# 公開サイト URL（開発時は http://localhost:3000）
NEXT_PUBLIC_SITE_URL=
# Supabase 公開 anon キー（Project Settings / API）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase プロジェクト URL（Project Settings / API）
NEXT_PUBLIC_SUPABASE_URL=
# Web Push 公開 VAPID キー（既存運営の鍵ペア）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Resend API キー（既存メール機能。Resend Dashboard）
RESEND_API_KEY=
# Supabase service_role キー（Project Settings / API。ブラウザ公開禁止）
SUPABASE_SERVICE_ROLE_KEY=
# Threads アクセストークン（Meta 開発者設定）
THREADS_ACCESS_TOKEN=
# Threads ユーザー ID（Meta 開発者設定）
THREADS_USER_ID=
# Web Push 秘密 VAPID キー（公開キーと対になる運営の鍵）
VAPID_PRIVATE_KEY=
# Web Push 連絡先 mailto URL（運営が指定）
VAPID_SUBJECT=
# VOICEVOX ENGINE URL（省略時 http://127.0.0.1:50021）
VOICEVOX_URL=
